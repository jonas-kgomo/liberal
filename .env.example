# Local development: copy this file to .dev.vars (gitignored).
# Hosted deployment: configure the same names as server-side runtime secrets.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional separate judge. Otherwise uses the same requested model, disclosed on cards.
OPENAI_JUDGE_MODEL=
# Optional voice transcription model. Defaults to whisper-1.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
